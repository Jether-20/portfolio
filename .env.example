# Contact form (Resend) — optional.
# The site builds and runs without these; the contact form will show a
# friendly "email me directly" message until a key is configured.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Copy this file to .env.local and fill in the values.

RESEND_API_KEY=

# Where contact messages are delivered. Defaults to the address in src/content/site.ts.
CONTACT_TO_EMAIL=

# Verified Resend sender. Until you verify a domain, Resend's sandbox sender works:
#   Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=
